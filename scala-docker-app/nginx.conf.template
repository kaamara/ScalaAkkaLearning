# To jest szablon, nie gotowy config. Obraz nginx podstawia za
# ${BACKEND_PORT} prawdziwa wartosc przy starcie kontenera.
# Podmieniane sa tylko zmienne na BACKEND_ (patrz NGINX_ENVSUBST_FILTER),
# zeby nie ruszyl wlasnych zmiennych nginxa w stylu $uri czy $host.
server {
    listen 80;
    server_name _;

    root /usr/share/nginx/html;
    index index.html;

    location / {
        try_files $uri $uri/ =404;
    }

    # Wszystko spod /api/ idzie do backendu.
    # Strona i backend sa pod tym samym adresem, wiec przegladarka nie
    # blokuje zapytan i nie trzeba naglowkow CORS.
    # Ukosnik na koncu proxy_pass obcina /api: /api/messages -> /messages.
    location /api/ {
        proxy_pass http://scala-app:${BACKEND_PORT}/;

        proxy_set_header Host              $host;
        proxy_set_header X-Real-IP         $remote_addr;
        proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;

        # Limit wielkosci zapytania. Za duze odpadaja tu, zanim backend
        # zacznie je czytac.
        client_max_body_size 8k;

        proxy_connect_timeout 5s;
        proxy_read_timeout    30s;
    }
}
